{
  "name": "dsh-sticky-note-panel",
  "version": "1.0.11",
  "type": "module",
  "license": "MIT",
  "description": "Sticky notes for the DSH Web UI: a draggable floating panel, a full page in the sidebar, Markdown preview, and settings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stallenlu/dsh-sticky-notes.git"
  },
  "homepage": "https://github.com/stallenlu/dsh-sticky-notes#readme",
  "bugs": {
    "url": "https://github.com/stallenlu/dsh-sticky-notes/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
